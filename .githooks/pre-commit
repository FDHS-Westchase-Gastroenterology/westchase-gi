#!/bin/sh
# Runs scripts/pre-commit.mjs on the staged files: the local-only guard (local-only-paths.json),
# oxfmt, oxlint and the duplicate-code check. npm ci and npm install point core.hooksPath here
# through the prepare script; npm run hooks:install does it by hand.
# Bypass deliberately with: git commit --no-verify
exec node scripts/pre-commit.mjs
