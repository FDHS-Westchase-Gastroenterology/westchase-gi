{
  "name": "westchase-gi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:mission": "mkdir -p .logs; lsof -ti tcp:3100 | xargs -r kill -9; exec next dev -p 3100",
    "build": "next build",
    "start": "next start",
    "doctor": "npx react-doctor --blocking none",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "hooks:install": "git config core.hooksPath .githooks",
    "local-only:check": "node scripts/check-local-only.mjs tracked",
    "local-only:verify": "node scripts/check-local-only.mjs verify-generated",
    "local-only:write": "node scripts/check-local-only.mjs write",
    "test:e2e-guard": "node --test e2e/target-guard.test.mjs e2e/dictionary-availability.test.mjs",
    "test:unit": "node --test scripts/check-local-only.test.mjs src/lib/portal/*.test.mjs tools/oxlint/anti-slop/plugin.test.mjs",
    "ui:reference": "node scripts/capture-ui-reference.mjs",
    "ui:reference:portal": "node --env-file-if-exists=.env.local scripts/capture-ui-reference.mjs --portal"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "16.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-zoom-pan-pinch": "^4.0.3",
    "resend": "6.34.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.89.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsqr": "^1.4.0",
    "oxfmt": "^0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "pdf-lib": "^1.17.1",
    "pngjs": "^7.0.0",
    "react-doctor": "^0.9.18",
    "tailwindcss": "^4",
    "typescript": "^6"
  }
}
