{
  "name": "westchase-gi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:mission": "mkdir -p .logs; lsof -ti tcp:3100 | xargs -r kill -9; exec next dev -p 3100",
    "build": "next build",
    "start": "next start",
    "doctor": "npx react-doctor --blocking none",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test:e2e-guard": "node --test e2e/target-guard.test.mjs e2e/dictionary-availability.test.mjs",
    "test:e2e": "node scripts/run-e2e.mjs $(ls e2e/*.spec.ts)",
    "test:e2e:nojs": "node scripts/run-e2e.mjs --project=no-js $(ls e2e/*.spec.ts)",
    "test:e2e:smoke": "node scripts/run-e2e.mjs e2e/smoke.spec.ts",
    "test:unit": "node --test src/lib/portal/*.test.mjs src/lib/portal/workflow/*.test.mjs tools/oxlint/anti-slop/plugin.test.mjs",
    "ui:reference": "tsx scripts/capture-ui-reference.mjs",
    "ui:reference:portal": "tsx --env-file-if-exists=.env.local scripts/capture-ui-reference.mjs --portal"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-zoom-pan-pinch": "^4.0.3",
    "resend": "6.19.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@browserbasehq/stagehand": "^3.7.2",
    "@oxlint/plugins": "1.78.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsqr": "^1.4.0",
    "oxfmt": "^0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pdf-lib": "^1.17.1",
    "playwright-core": "1.55.1",
    "pngjs": "^7.0.0",
    "react-doctor": "^0.9.12",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^6"
  }
}
