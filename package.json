{
  "name": "westchase-gi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-patients.mjs && next dev",
    "dev:patients": "node scripts/dev-patients.mjs",
    "dev:mission": "mkdir -p .logs; lsof -ti tcp:3100 | xargs -r kill -9; exec next dev -p 3100",
    "build": "next build",
    "start": "next start",
    "doctor": "npx react-doctor --blocking none",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "hooks:install": "git config core.hooksPath .githooks",
    "local-only:check": "node scripts/check-local-only.mjs tracked",
    "local-only:verify": "node scripts/check-local-only.mjs verify-generated",
    "local-only:write": "node scripts/check-local-only.mjs write",
    "test:unit": "node --import ./test/register.mjs --test \"src/**/*.test.mjs\" \"scripts/**/*.test.mjs\" \"tools/**/*.test.mjs\" \"test/**/*.test.mjs\"",
    "test:e2e-guard": "node --test e2e/harness/target-guard.test.mjs",
    "test:e2e:public": "PLAYWRIGHT_PUBLIC=1 playwright test e2e/public",
    "test:e2e:portal": "playwright test e2e/portal",
    "test:e2e:boundaries": "playwright test e2e/boundaries",
    "test:e2e": "playwright test",
    "ui:reference": "node scripts/capture-ui-reference.mjs",
    "ui:reference:portal": "node --env-file-if-exists=.env.local scripts/capture-ui-reference.mjs --portal",
    "ds:stock": "node scripts/design-system/sync-stock.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@shadcn/react": "^0.3.0",
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.112.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.37.0",
    "motion": "^13.1.1",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "^4.12.3",
    "react-zoom-pan-pinch": "^4.0.3",
    "recharts": "^3.8.0",
    "resend": "6.25.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.80.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsqr": "^1.4.0",
    "oxfmt": "^0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pdf-lib": "^1.17.1",
    "pngjs": "^7.0.0",
    "react-doctor": "^0.9.12",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4",
    "typescript": "^6"
  }
}
