{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enableAllProjectMcpServers": true,
  "permissions": {
    "deny": [
      "Bash(git push --force origin main*)",
      "Bash(git push -f origin main*)",
      "Bash(git push --force-with-lease origin main*)",
      "Bash(git push origin +main*)",
      "Bash(git push origin --delete main*)",
      "Bash(git push origin :main*)"
    ],
    "ask": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(terraform destroy*)",
      "Bash(terraform apply -destroy*)",
      "Bash(terraform state rm*)",
      "Bash(aws * delete-*)",
      "Bash(aws * terminate-*)",
      "Bash(aws s3 rb*)",
      "Bash(aws s3 rm*)",
      "Bash(aws organizations close-account*)",
      "Bash(dropdb*)",
      "Bash(supabase projects delete*)",
      "Bash(supabase branches delete*)",
      "Bash(vercel remove*)",
      "Bash(vercel rm*)",
      "Bash(vercel project rm*)",
      "Bash(gh repo delete*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-destructive.sh"
          }
        ]
      }
    ]
  }
}
