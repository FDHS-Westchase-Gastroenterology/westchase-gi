{
  /* Declaration-only build for the design-sync barrel. Mirrors the repo
     tsconfig but emits .d.ts (the converter reads these as the design
     agent's API contract) and swaps next/* for browser shims, since the
     bundle runs outside Next.
     NB: use block comments only. design-sync's tsconfig reader strips
     `//` line comments with a regex that also eats a JSON key literally
     named "//", which breaks its parse and silently disables the whole
     paths plugin — real next/* then gets bundled. */
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "ignoreDeprecations": "6.0",
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./types",
    "rootDir": "../..",
    "baseUrl": "../..",
    "paths": {
      /* Directory imports must be listed BEFORE the "@/*" wildcard.
         design-sync's paths plugin probes extensions with a bare existsSync
         and tries the empty extension first, so a directory that has an
         index.ts resolves to the DIRECTORY and esbuild fails with
         "Cannot read file ...: is a directory". Rules are tried in key order,
         so an exact entry ahead of the wildcard wins. */
      "@/lib/content/education": ["src/lib/content/education/index.ts"],
      "@/lib/content/preps": ["src/lib/content/preps/index.ts"],
      "@/app/design/brand": ["src/app/design/brand/index.ts"],
      "@/app/design/stock-examples": ["src/app/design/stock-examples/index.ts"],
      "@/*": ["src/*"],
      "next/link": [".design-sync/ds/shims/next-link.tsx"],
      "next/image": [".design-sync/ds/shims/next-image.tsx"],
      "next/navigation": [".design-sync/ds/shims/next-navigation.ts"]
    }
  },
  "include": ["entry.ts"]
}
