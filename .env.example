# Supabase Preview Branch used by workstation app/E2E work. Fetch these with
# `supabase branches get <git-branch> --project-ref <production-ref> -o env`.
NEXT_PUBLIC_SUPABASE_URL=YOUR_PREVIEW_BRANCH_URL
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PREVIEW_BRANCH_PUBLISHABLE_KEY
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PREVIEW_BRANCH_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_PREVIEW_BRANCH_SERVICE_ROLE_KEY
# Optional override; when unset, derived from SUPABASE_SERVICE_ROLE_KEY. Rotating
# the service-role key re-keys fingerprints and may conflict only with retries spanning rotation.
WORKFLOW_COMMAND_HMAC_KEY=YOUR_WORKFLOW_COMMAND_HMAC_KEY
SUPABASE_BRANCH_PROJECT_REF=YOUR_PREVIEW_BRANCH_PROJECT_REF
SUPABASE_PROJECT_REF=YOUR_PREVIEW_BRANCH_PROJECT_REF
SUPABASE_PREVIEW_BRANCH=1
POSTGRES_URL=YOUR_PREVIEW_BRANCH_POOLER_DATABASE_URL
POSTGRES_URL_NON_POOLING=YOUR_PREVIEW_BRANCH_DIRECT_DATABASE_URL
SUPABASE_DB_PASSWORD=YOUR_SUPABASE_DB_PASSWORD
PLAYWRIGHT_ALLOWED_SUPABASE_PROJECT_REF=YOUR_PREVIEW_BRANCH_PROJECT_REF

# Explicit production aliases for migration and verification tooling
SUPABASE_URL_PROD=YOUR_PRODUCTION_SUPABASE_URL
SUPABASE_PUBLISHABLE_KEY_PROD=YOUR_PRODUCTION_SUPABASE_PUBLISHABLE_KEY
SUPABASE_ANON_KEY_PROD=YOUR_PRODUCTION_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY_PROD=YOUR_PRODUCTION_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_PROJECT_REF_PROD=YOUR_PRODUCTION_SUPABASE_PROJECT_REF
SUPABASE_DB_PASSWORD_PROD=YOUR_PRODUCTION_SUPABASE_DB_PASSWORD

# Current production email adapter and portal links
RESEND_API_KEY=YOUR_RESEND_API_KEY
RESEND_FROM=YOUR_RESEND_FROM_ADDRESS
PORTAL_BASE_URL=YOUR_PORTAL_BASE_URL

# Shared staff-portal alias for Vercel Preview only; never set in Production
PORTAL_PREVIEW_USERNAME=YOUR_PREVIEW_USERNAME
PORTAL_PREVIEW_PASSWORD=YOUR_PREVIEW_PASSWORD

# GitHub App registry connection (server-only; never use a personal access token)
PORTAL_GITHUB_APP_ID=YOUR_GITHUB_APP_ID
PORTAL_GITHUB_APP_INSTALLATION_ID=YOUR_GITHUB_APP_INSTALLATION_ID
PORTAL_GITHUB_APP_PRIVATE_KEY=YOUR_BASE64_OR_NEWLINE_ESCAPED_PRIVATE_KEY

# Seeded portal admin on Preview Branches; used by E2E and as the
# underlying Vercel Preview review identity, never by Production
PORTAL_SEED_ADMIN_EMAIL=YOUR_TEST_ADMIN_EMAIL
PORTAL_SEED_ADMIN_PASSWORD=YOUR_TEST_ADMIN_PASSWORD

# Operator-only Production activation/verification credentials (never put in
# Vercel, never used by Playwright, and never allowed to fall back to Dev E2E)
PORTAL_PROD_ADMIN_EMAIL=YOUR_PRODUCTION_ADMIN_EMAIL
PORTAL_PROD_ADMIN_PASSWORD=YOUR_PRODUCTION_ADMIN_PASSWORD
