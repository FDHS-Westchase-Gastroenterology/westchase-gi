#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ ! -s "$NVM_DIR/nvm.sh" ]; then
  echo "error: the orb Node.js toolchain is missing; run .agents/setup" >&2
  exit 1
fi

# shellcheck disable=SC1091
. "$NVM_DIR/nvm.sh" --no-use
node_version="$(tr -d '[:space:]' < .nvmrc)"
nvm use --silent "$node_version" >/dev/null

for executable in node_modules/.bin/next node_modules/.bin/playwright; do
  if [ ! -x "$executable" ]; then
    echo "error: orb dependencies are incomplete; run .agents/setup" >&2
    exit 1
  fi
done

node <<'NODE'
const { existsSync } = require("node:fs");
const { chromium } = require("playwright");

if (!existsSync(chromium.executablePath())) {
  console.error("error: the Chromium browser is missing; run .agents/setup");
  process.exit(1);
}
NODE

echo "Orb prerequisites are ready; this repository has no persistent local services to resume."
