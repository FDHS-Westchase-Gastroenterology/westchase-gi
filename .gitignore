# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-e2e/
/out/

# production
/build

# generated scratch builds
/private/tmp/

# misc
.DS_Store
*.pem

# Local Cursor hooks/skills (machine-local; not part of the public product)
.cursor/

# Local backend coordination memos (not part of the public product)
backend-memos/

# Local QA evidence (parity screenshots, dev-server logs)
.product-design-audit/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local runtime logs (dev server output for the QA harness)
/.logs/

# playwright artifacts
/playwright-report/
/test-results/

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
